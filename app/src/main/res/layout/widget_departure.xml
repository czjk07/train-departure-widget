<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_next_train"
        android:textColor="@color/title_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/train_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/no_train_time"
        android:textColor="@color/train_time"
        android:textSize="40sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/bus1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/bus1_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bus1_label"
            android:textColor="@color/bus_label"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bus1_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_bus"
            android:textColor="@color/bus_detail"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bus2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <TextView
            android:id="@+id/bus2_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bus2_label"
            android:textColor="@color/bus_label"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bus2_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_bus"
            android:textColor="@color/bus_detail"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
